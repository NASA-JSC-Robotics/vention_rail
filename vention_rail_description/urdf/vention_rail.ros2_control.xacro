<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
   <xacro:macro name="vention_rail_ros2_control" params="
    name
    tf_prefix
    use_fake_hardware:=false
    ip_addr:=192.168.7.2
    port:=9999
    position_limit:=2.0
    velocity_limit:=0.15
    acceleration_limit:=1.0
    safety_com_port:=/dev/ttyACM0">
        <xacro:unless value="${use_fake_hardware}">
            <ros2_control name="${name}" type="actuator">
                <hardware>
                    <plugin>vention_rail_hardware_interface/RailEHardwareInterface</plugin>
                    <param name="rail_name">vention_rail</param>
                    <param name="ip_addr">${ip_addr}</param>
                    <param name="port">${port}</param>
                    <param name="position_limit">${position_limit}</param>
                    <param name="velocity_limit">${velocity_limit}</param>
                    <param name="acceleration_limit">${acceleration_limit}</param>
                    <param name="safety_com_port">${safety_com_port}</param>
                </hardware>
                <joint name="${tf_prefix}vention_rail_base_to_carriage">
                    <command_interface name="position">
                        <param name="min">0</param>
                        <param name="max">2.0</param>
                    </command_interface>
                    <state_interface name="position"/>
                    <state_interface name="velocity"/>
                    <state_interface name="robot_ready"/>
                </joint>
            </ros2_control>
        </xacro:unless>

        <xacro:if value="${use_fake_hardware}">
            <ros2_control name="${name}" type="system">
                <hardware>
                    <plugin>mock_components/GenericSystem</plugin>
                </hardware>
                <joint name="${tf_prefix}vention_rail_base_to_carriage">
                <command_interface name="position">
                    <param name="min">0</param>
                    <param name="max">2.0</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="robot_ready"/>
                </joint>
            </ros2_control>
        </xacro:if>
    </xacro:macro>
</robot>
